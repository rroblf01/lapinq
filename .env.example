# Lapinq Configuration
# Copy this to .env and adjust as needed

# Database
DATABASE_URL=postgresql://postgres:test@localhost:5432/lapinq

# Server
LAPINQ_API_KEY=
LAPINQ_SESSION_SECRET=  # Auto-generated if empty; set a fixed value to persist sessions across restarts
LAPINQ_RATE_LIMIT=0
LAPINQ_CORS_ORIGINS=*
LAPINQ_API_PREFIX=/api/v1

# Payload
LAPINQ_MAX_PAYLOAD_SIZE=102400

# Database pool
LAPINQ_POOL_SIZE=10
LAPINQ_DB_TIMEOUT=30

# Worker
LAPINQ_HEARTBEAT_INTERVAL=15
LAPINQ_MAX_IDLE_BACKOFF=5
LAPINQ_STALE_RECOVERY_INTERVAL=300
LAPINQ_WORKER_ID=

# Logging
LAPINQ_LOG_LEVEL=info
LAPINQ_JSON_LOG=false

# Rust worker (lapinq-worker CLI)
LAPINQ_PYTHON=
